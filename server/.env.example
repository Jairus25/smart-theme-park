# Copy this file to .env and fill in your own Couchbase Capella credentials.
#
# In Capella: Clusters -> your cluster -> "Connect" tab gives the connection
# string (starts with couchbases://...). Create a database credential under
# "Security -> Database Access" (this is NOT your Capella login -- it's a
# separate username/password just for app connections), and make sure your
# current IP is allow-listed under "Security -> Networking" or the
# connection will time out.
CB_CONNECTION_STRING=couchbases://cb.mbhmmxnvw-a6wxwt.cloud.couchbase.com
CB_USERNAME=theme_park_app
CB_PASSWORD=<the password you saved earlier>
CB_BUCKET=theme_park
CB_SCOPE=park

PORT=4000